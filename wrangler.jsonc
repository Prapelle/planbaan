{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planbaan",
  // worker.ts ห่อ worker ของ OpenNext เพื่อเพิ่มงานตามเวลา (สำรองข้อมูลรายวัน)
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // ใช้โดเมน workers.dev ระหว่างยังไม่มีโดเมนจริง · ปิด preview URL เพราะล็อกอิน Google ใช้ได้เฉพาะ URL หลัก
  "workers_dev": true,
  "preview_urls": false,
  // ให้ Cloudflare วาง Worker ไว้ใกล้ฐานข้อมูล D1 อัตโนมัติ: หน้าหนึ่งคุยกับฐานข้อมูลหลายรอบ ยิ่งใกล้ยิ่งเร็ว
  "placement": { "mode": "smart" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // ฐานข้อมูลหลัก: เก็บตารางระบบ (projects, memberships ฯลฯ) และข้อมูลโครงการกลุ่มแรก
  // เมื่อต้องแบ่งฐานข้อมูล ให้เพิ่ม binding ใหม่ เช่น DB_2 แล้วตั้ง projects.shard = 'DB_2' ให้โครงการที่ย้าย
  "d1_databases": [
    { "binding": "DB", "database_name": "planbaan-db", "database_id": "d7ec0c2f-81c1-425a-833a-fcfcad2a0b05", "migrations_dir": "migrations" }
  ],
  // ที่เก็บไฟล์สำรองรายวัน (และรูปในระยะถัดไป)
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "planbaan-backups" }],
  // สำรองข้อมูลทุกวันเวลา 03:00 น. ไทย (20:00 UTC)
  "triggers": { "crons": ["0 20 * * *"] },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // ค่าที่ไม่ลับตั้งตรงนี้ ค่าลับ (AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, USAGE_SALT) ใช้ `wrangler secret put` หรือหน้า Settings ของ Worker
  "vars": {
    "AUTH_TRUST_HOST": "true",
    // โดเมนหลัก เช่น planbaan.app (ยังไม่ได้เลือก) — โครงการใช้ <slug>.<BASE_DOMAIN>
    "BASE_DOMAIN": "",
    // เปิดไว้ระหว่างยังไม่มีโดเมน: เลือกโครงการผ่าน /api/dev/project?slug=<slug> บนโดเมน workers.dev
    "ALLOW_PROJECT_SWITCH": "true",
    "BACKUP_RETENTION_DAYS": "30",
    // ประวัติลูกค้าเก่ากว่านี้ (วัน) ย้ายไปเก็บถาวรใน R2
    "ARCHIVE_DAYS": "365",
    // ช่วงทดลองของโครงการใหม่ (วัน) และยอดซื้อ Pure Product ขั้นต่ำรวม 3 เดือน (บาท) — ค่าชั่วคราว รอเจ้าของตัดสินใจ
    "TRIAL_DAYS": "60",
    "PURE_MIN_BAHT": "30000",
    // ราคาส่วนก่อสร้างต่อหลังที่กำลังก่อสร้างต่อเดือน (บาท) — ค่าชั่วคราว
    "BUILD_PRICE_BAHT": "400",
    // แสดงในหน้า /privacy และ /terms: ผู้ให้บริการ และอีเมลติดต่อเรื่องข้อมูลส่วนบุคคล (ว่าง = ใช้ INITIAL_ADMIN_EMAIL)
    "OPERATOR_NAME": "บุรีรัมย์น่าอยู่",
    "CONTACT_EMAIL": ""
  }
}
